# Branch on the kind of failure, not on its wording:
tryCatch(
  cpt_detect(rnorm(50), method = "pelt", change_in = "network"),
  ggchangepoint_unsupported = function(e) {
    paste("unsupported:", e$method, "offers", toString(e$supported))
  }
